{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DescribeOnlyTargetInstance",
            "Effect": "Allow",
            "Action": [
                "ec2:DescribeInstances",
                "ec2:DescribeInstanceStatus",
                "ec2:DescribeTags"
            ],
            "Resource": "arn:aws:ec2:*:*:instance/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/Name": "db-on-ec2-api-repo-backup"
                }
            }
        },
        {
            "Sid": "StateControlTargetInstance",
            "Effect": "Allow",
            "Action": [
                "ec2:StartInstances",
                "ec2:StopInstances",
                "ec2:RebootInstances"
            ],
            "Resource": "arn:aws:ec2:*:*:instance/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/Name": "db-on-ec2-api-repo-backup"
                }
            }
        },
        {
            "Sid": "SSMToTargetInstance",
            "Effect": "Allow",
            "Action": [
                "ssm:StartSession",
                "ssm:TerminateSession",
                "ssm:ResumeSession"
            ],
            "Resource": "arn:aws:ec2:*:*:instance/*",
            "Condition": {
                "StringEquals": {
                    "aws:ResourceTag/Name": "db-on-ec2-api-repo-backup"
                }
            }
        }
   ]
}