{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3WriteFiles",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::bucket-api-file-repo/*"
    },
    {
      "Sid": "S3DeleteFiles",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::bucket-api-file-repo/*"
    },
    {
      "Sid": "S3ListFiles",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::bucket-api-file-repo",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["", "*"]
        }
      }
    }
  ]
}
