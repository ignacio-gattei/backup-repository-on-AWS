{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowListBackupBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::backups_db_app"
        },
        {
            "Sid": "AllowUploadAndDownloadBackups",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::backups_db_app/*"
        }
    ]
}