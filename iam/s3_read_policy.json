{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadFiles",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::bucket-api-file-repo/*"
    },
    {
      "Sid": "AllowListFiles",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::bucket-api-file-repo"
    }
  ]
}